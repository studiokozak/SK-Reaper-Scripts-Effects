desc:SK Gristleizer
// =============================================================================
// Studio Kozak — SK Gristleizer
// A personal reinterpretation of the Gristleizer effect.
// =============================================================================

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R

// Controls
slider1:0<0,1,1{VCA (tremolo/grit),VCF (swept filter)}>Mode
slider2:0<0,3,1{Triangle,Ramp,Pulse,Skew}>Waveform
slider3:0<-100,100,1>Bias
slider4:75<0,100,1>Depth (%)
slider5:4.0<0.02,115,0.01>Speed (Hz)
slider6:0<0,1,1{Off,On}>Tempo Sync
slider7:5<0,8,1{1/1,1/2,1/4,1/8,1/8T,1/16,1/16T,1/32,1/32T}>Sync Division
slider8:0<0,2,1{Linked,Stereo,Ping-Pong}>Stereo
slider9:0<-12,24,0.5>Gain (dB)
slider10:0<-24,12,0.5>Output (dB)
slider11:100<0,100,1>Mix (Dry/Wet) (%)

@init
// Setup: constants, states and fixed internal values.
srate_inv = 1.0 / srate;
pi_sr = $pi / srate;
noise_seed = 22153;
lfo_phase = 0.25;
icL1 = 0.0; icL2 = 0.0;
icR1 = 0.0; icR2 = 0.0;
g_fc_base = 520.0;
g_shp = 0.50;
g_off_dc = 0.0;
g_smooth_ms = 1.0;
g_hiss = 0.0005;

// Asymmetric germanium-style soft shaper used to shape the LFO.
function sk_germ(x) (
  x >= 0 ? x / (1.0 + 0.6 * x) : x / (1.0 - 0.25 * x);
);

// Asymmetric soft-clip saturation for the audio grit.
function sk_asym(x, d) (
  sa_x = x * d;
  sa_x > 0 ? sa_x / (1.0 + 0.6 * sa_x) : sa_x / (1.0 + 0.3 * (-sa_x));
);

// Bounded pseudo-random noise for the hiss.
function sk_noise() (
  noise_seed = noise_seed * 1664525.0 + 1013904223.0;
  noise_seed = noise_seed - floor(noise_seed / 4294967296.0) * 4294967296.0;
  noise_seed * (1.0 / 2147483648.0) - 1.0;
);

// Output brickwall limiter.
function sk_clip(x) (
  x > 3.0 ? 1.0 :
  x < -3.0 ? -1.0 : (
    sc_x2 = x * x;
    x * (27.0 + sc_x2) / (27.0 + 9.0 * sc_x2);
  );
);

// Raw LFO waveform: triangle, ramp, pulse or skew.
function sk_shape(ph) (
  g_wf < 0.5 ? (
    shp_pk = 0.05 + 0.90 * g_shp;
    ph < shp_pk ? (shp_v = ph / shp_pk) : (shp_v = (1.0 - ph) / (1.0 - shp_pk));
    shp_v = shp_v * 2.0 - 1.0;
  ) : g_wf < 1.5 ? (
    shp_g = 0.30 + 2.70 * g_shp;
    shp_v = pow(ph, shp_g) * 2.0 - 1.0;
  ) : g_wf < 2.5 ? (
    shp_pw = 0.05 + 0.90 * g_shp;
    shp_v = ph < shp_pw ? 1.0 : -1.0;
  ) : (
    shp_pk = 0.02 + 0.30 * g_shp;
    ph < shp_pk ? (shp_v = ph / shp_pk) : (shp_v = (1.0 - ph) / (1.0 - shp_pk));
    shp_v = shp_v * 2.0 - 1.0;
  );
  shp_v;
);

// Final LFO value: shaped, DC-removed and normalised.
function sk_lfo(ph) (
  sl_raw = sk_shape(ph);
  (sk_germ(sl_raw + g_off_dc) - g_off_dc_out) * g_norm;
);

// LFO normalisation and slew coefficient (depend only on fixed values).
g_off_dc_out = sk_germ(g_off_dc);
g_n_hi = sk_germ(1.0 + g_off_dc) - g_off_dc_out;
g_n_lo = sk_germ(-1.0 + g_off_dc) - g_off_dc_out;
g_norm = 1.0 / max(0.0001, max(abs(g_n_hi), abs(g_n_lo)));
g_smooth_coef = exp(-1.0 / (g_smooth_ms * 0.001 * srate));

@slider
// Reads the controls and derives the working parameters.
g_wf = slider2 | 0;
g_mode = slider1 | 0;
g_depth = slider4 * 0.01;
bias = slider3 * 0.01;
g_bias_gain = bias * 0.5;
g_grit = 0.30 + max(0.0, bias) * 1.8;
g_bias_oct = bias * 2.0;
g_drive = pow(10.0, slider9 / 20.0);
g_level = pow(10.0, slider10 / 20.0);
g_stereo = slider8 | 0;
g_st_offset = g_stereo == 1 ? 0.25 : g_stereo == 2 ? 0.5 : 0.0;
g_mix = slider11 * 0.01;
g_vcf_k = 1.0 / 3.2;
g_vcf_wet = 0.55;
g_vcf_dry = 0.45;
g_vca_makeup = 1.0 / (1.0 + g_grit * 0.5);
g_fcmod_oct = g_depth * 2.6;

@block
// Computes the LFO rate, free-running or tempo-synced.
slider6 >= 0.5 ? (
  bl_div = slider7 | 0;
  bl_beats =
    bl_div == 0 ? 4.0    : bl_div == 1 ? 2.0    : bl_div == 2 ? 1.0 :
    bl_div == 3 ? 0.5    : bl_div == 4 ? (0.5 * 2.0 / 3.0) :
    bl_div == 5 ? 0.25   : bl_div == 6 ? (0.25 * 2.0 / 3.0) :
    bl_div == 7 ? 0.125  : (0.125 * 2.0 / 3.0);
  bl_sec = bl_beats * 60.0 / max(1.0, tempo);
  g_rate_hz = 1.0 / max(0.0001, bl_sec);
) : (
  g_rate_hz = slider5;
);
g_inc = g_rate_hz * srate_inv;

@sample
// Dry capture.
sp_dryL = spl0;
sp_dryR = spl1;

// LFO with optional stereo phase offset and light slew.
sp_lfoL = sk_lfo(lfo_phase);
sp_phR = lfo_phase + g_st_offset;
sp_phR >= 1.0 ? sp_phR -= 1.0;
sp_lfoR = sk_lfo(sp_phR);
lfo_sL = lfo_sL + (sp_lfoL - lfo_sL) * (1.0 - g_smooth_coef);
lfo_sR = lfo_sR + (sp_lfoR - lfo_sR) * (1.0 - g_smooth_coef);
lfo_phase += g_inc;
lfo_phase >= 1.0 ? lfo_phase -= 1.0;

// Input gain.
sp_L = sp_dryL * g_drive;
sp_R = sp_dryR * g_drive;

g_mode < 0.5 ? (
  // VCA mode: unity-topped tremolo with grit.
  sp_uL = 0.5 + 0.5 * lfo_sL;
  sp_uR = 0.5 + 0.5 * lfo_sR;
  sp_gL = max(0.0, 1.0 - g_depth * (1.0 - sp_uL) + g_bias_gain);
  sp_gR = max(0.0, 1.0 - g_depth * (1.0 - sp_uR) + g_bias_gain);
  sp_L = sk_asym(sp_L, 1.0 + g_grit) * sp_gL * g_vca_makeup;
  sp_R = sk_asym(sp_R, 1.0 + g_grit) * sp_gR * g_vca_makeup;
) : (
  // VCF mode: LFO-swept resonant band-pass blended with dry.
  sp_fcL = g_fc_base * pow(2.0, g_bias_oct + g_fcmod_oct * lfo_sL);
  sp_fcR = g_fc_base * pow(2.0, g_bias_oct + g_fcmod_oct * lfo_sR);
  sp_fcL = max(20.0, min(srate * 0.45, sp_fcL));
  sp_fcR = max(20.0, min(srate * 0.45, sp_fcR));
  sp_gL = tan(pi_sr * sp_fcL);
  sp_a1L = 1.0 / (1.0 + sp_gL * (sp_gL + g_vcf_k));
  sp_a2L = sp_gL * sp_a1L;
  sp_a3L = sp_gL * sp_a2L;
  sp_v3L = sp_L - icL2;
  sp_v1L = sp_a1L * icL1 + sp_a2L * sp_v3L;
  sp_v2L = icL2 + sp_a2L * icL1 + sp_a3L * sp_v3L;
  icL1 = 2.0 * sp_v1L - icL1;
  icL2 = 2.0 * sp_v2L - icL2;
  sp_L = sp_dryL * g_vcf_dry + sp_v1L * g_vcf_wet;
  sp_gR = tan(pi_sr * sp_fcR);
  sp_a1R = 1.0 / (1.0 + sp_gR * (sp_gR + g_vcf_k));
  sp_a2R = sp_gR * sp_a1R;
  sp_a3R = sp_gR * sp_a2R;
  sp_v3R = sp_R - icR2;
  sp_v1R = sp_a1R * icR1 + sp_a2R * sp_v3R;
  sp_v2R = icR2 + sp_a2R * icR1 + sp_a3R * sp_v3R;
  icR1 = 2.0 * sp_v1R - icR1;
  icR2 = 2.0 * sp_v2R - icR2;
  sp_R = sp_dryR * g_vcf_dry + sp_v1R * g_vcf_wet;
);

// Subtle hiss.
sp_n = g_hiss * (0.6 + 0.4 * g_drive);
sp_L += sk_noise() * sp_n;
sp_R += sk_noise() * sp_n;

// Output gain, dry/wet mix and safety limiting.
sp_L *= g_level;
sp_R *= g_level;
sp_outL = sp_dryL * (1.0 - g_mix) + sp_L * g_mix;
sp_outR = sp_dryR * (1.0 - g_mix) + sp_R * g_mix;
sp_outL = sp_outL < 1000.0 ? (sp_outL > -1000.0 ? sp_outL : 0.0) : 0.0;
sp_outR = sp_outR < 1000.0 ? (sp_outR > -1000.0 ? sp_outR : 0.0) : 0.0;
spl0 = sk_clip(sp_outL);
spl1 = sk_clip(sp_outR);

